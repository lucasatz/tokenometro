{
  "name": "tokenometro",
  "displayName": "Tokenômetro",
  "description": "Saiba se, no seu ritmo, os tokens do Claude Code vão acabar antes de o limite renovar.",
  "version": "0.1.2",
  "publisher": "lucasatz",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/lucasatz/tokenometro.git"
  },
  "bugs": {
    "url": "https://github.com/lucasatz/tokenometro/issues"
  },
  "homepage": "https://github.com/lucasatz/tokenometro#readme",
  "icon": "icon.png",
  "preview": true,
  "pricing": "Free",
  "galleryBanner": {
    "color": "#1E2A4A",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "keywords": [
    "claude",
    "claude code",
    "limite",
    "usage",
    "rate limit",
    "forecast",
    "tokens"
  ],
  "extensionDependencies": [
    "anthropic.claude-code"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "contributes": {
    "configuration": {
      "title": "Tokenômetro",
      "properties": {
        "tokenometro.barraDeStatus": {
          "type": "boolean",
          "default": false,
          "description": "Mostrar a previsão também na barra de status do VS Code. Ela já aparece dentro do painel do Claude Code, acima do campo de mensagem."
        },
        "tokenometro.abrirPainelAoIniciar": {
          "type": "boolean",
          "default": false,
          "description": "Abrir o painel do Tokenômetro toda vez que uma sessão do Claude Code começar, no lugar da linha junto ao campo de mensagem. No VS Code e no terminal em tela cheia, o painel fica numa coluna ao lado da conversa."
        }
      }
    },
    "commands": [
      {
        "command": "tokenometro.mostrarDetalhes",
        "title": "Mostrar previsão de uso",
        "category": "Tokenômetro"
      },
      {
        "command": "tokenometro.instalarPlugin",
        "title": "Instalar plugin no Claude Code",
        "category": "Tokenômetro"
      },
      {
        "command": "tokenometro.removerPlugin",
        "title": "Remover plugin do Claude Code",
        "category": "Tokenômetro"
      }
    ]
  }
}
